# Copy to .env.local (dashboard) and extension/.env (extension) and fill in real values.
# All values below are placeholders — never commit real credentials.

# OpenRouter key for the privacy-policy AI analyzer proxy (/api/analyze)
OPENROUTER_API_KEY=***REVOKED-OPENROUTER-KEY***

# Supabase service-role key (server-only; bypasses RLS — keep secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase project URL (public; used by the Next.js dashboard client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/publishable key (public; used by the Next.js dashboard client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Resend API key for GDPR Article 17 revocation emails
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dashboard base URL the browser extension talks to (Vite; also injected into
# the extension's externally_connectable matches and TRUSTED_HOSTNAMES)
VITE_DASHBOARD_URL=https://consently.vercel.app

# Enables the seeded demo login shortcut (demo@consently.ai) — default off.
# Next.js only exposes NEXT_PUBLIC_* vars to the browser, so set both for a local demo.
DEMO_LOGIN_ENABLED=false
NEXT_PUBLIC_DEMO_LOGIN_ENABLED=false

# Optional overrides for the dashboard's extension handshake defaults
# NEXT_PUBLIC_DASHBOARD_URL=https://consently.vercel.app
# NEXT_PUBLIC_EXTENSION_ID=kegngnalimkofmfaeefinlljgdhomgon
